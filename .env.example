# ==============================================================================
# YUVA SATHI (युवा साथी) - ENVIRONMENT VARIABLES REFERENCE
# "Your money. Your life. Your साथी."
#
# Copy this file to .env.local to configure live external cloud services.
# NOTE: All integrations feature deterministic fallbacks — the application
# is 100% functional and testable even with ZERO environment variables set!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI (AI Money Coach)
# Get your free API key at: https://aistudio.google.com/app/apikey
# If absent: Grounded Local Rule Engine runs automatically with zero errors.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=alternative_key_name_here

# ------------------------------------------------------------------------------
# 2. SUPABASE (PostgreSQL Cloud Persistence & Auth)
# Create a free project at: https://supabase.com
# Execute the SQL schema in `supabase/schema.sql` to initialize tables & RLS.
# If absent: Dual-namespaced LocalStorage engine runs with isolated demo sandbox.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT (Proactive Financial Alerts & Bot Commands)
# Create your bot via @BotFather on Telegram (https://t.me/BotFather)
# If absent: In-app notification previews & simulated evaluator dispatch.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=YuvaSathiBot
TELEGRAM_WEBHOOK_SECRET=your_custom_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. GNANI.AI (Voice Money Coach - Speech-to-Text & Text-to-Speech)
# Request API access at: https://gnani.ai
# If absent: Browser Web Speech Recognition & SpeechSynthesis (en-IN) active.
# ------------------------------------------------------------------------------
GNANI_API_KEY=your_gnani_api_key_here
GNANI_STT_ENDPOINT=https://asr.gnani.ai/v1/recognize
GNANI_TTS_ENDPOINT=https://tts.gnani.ai/v1/synthesize

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT & DEPLOYMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
